rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validators
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId', 'email'])
        && data.userId == userId
        && data.userId is string && data.userId.size() <= 128
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('tier' in data) || (data.tier is string && data.tier.size() <= 64));
    }

    function isValidWishlistItem(data, userId) {
      return data.keys().hasAll(['productId', 'userId'])
        && data.userId == userId
        && data.productId is string && data.productId.size() <= 128
        && (!('addedAt' in data) || (data.addedAt is string && data.addedAt.size() <= 64));
    }

    function isValidCartItem(data, userId) {
      return data.keys().hasAll(['productId', 'userId', 'color', 'size', 'quantity'])
        && data.userId == userId
        && data.productId is string && data.productId.size() <= 128
        && data.color is string && data.color.size() <= 64
        && data.size is string && data.size.size() <= 32
        && data.quantity is number && data.quantity >= 1 && data.quantity <= 99;
    }

    function isValidOrder(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'total', 'status'])
        && data.userId == userId
        && data.id is string && data.id.size() <= 128
        && data.total is number && data.total >= 0
        && data.status is string && data.status.size() <= 64;
    }

    function isValidChatMessage(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'role', 'text'])
        && data.userId == userId
        && data.id is string && data.id.size() <= 128
        && data.role in ['user', 'model', 'system']
        && data.text is string && data.text.size() <= 20000;
    }

    // User profile and subcollections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow delete: if false;

      // Wishlist subcollection
      match /wishlist/{productId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidWishlistItem(incoming(), userId);
        allow delete: if isOwner(userId);
      }

      // Cart subcollection
      match /cart/{cartItemId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCartItem(incoming(), userId);
        allow delete: if isOwner(userId);
      }

      // Orders subcollection
      match /orders/{orderId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidOrder(incoming(), userId);
        allow update: if isOwner(userId) && isValidOrder(incoming(), userId);
        allow delete: if false;
      }

      // Concierge chat history subcollection
      match /chat_messages/{messageId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidChatMessage(incoming(), userId);
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }
  }
}
